# expo-router pulls react-dom/@radix-ui (web-only) with a peer range
# that conflicts with our pinned react version. Not exercised on
# Android/iOS. See specs/pantalla-tasks/design.md.
legacy-peer-deps=true
# Con legacy-peer-deps npm no ve que ajv-keywords@5 (de schema-utils, que
# usa el plugin de expo-quick-actions) pide ajv ^8 como peer, y lo dejaba
# junto al ajv 6 de ESLint: el prebuild fallaba con "Cannot find module
# 'ajv/dist/compile/codegen'". Por eso package.json declara ajv ^8 en
# devDependencies: ajv 8 queda en la raíz y ESLint se lleva su ajv 6.
