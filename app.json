{
  "expo": {
    "name": "Logday Mobile",
    "slug": "logday-mobile",
    "scheme": "logdaymobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "dev.logday.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "userInterfaceStyle": "automatic",
      "package": "dev.logday.app",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#6366f1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-status-bar",
      "expo-router",
      "expo-localization",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["text/*"],
          "disableIOS": true
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_task": {
              "foregroundImage": "./assets/quick-actions/task.png",
              "backgroundColor": "#ffffff"
            },
            "shortcut_note": {
              "foregroundImage": "./assets/quick-actions/note.png",
              "backgroundColor": "#ffffff"
            },
            "shortcut_daily": {
              "foregroundImage": "./assets/quick-actions/daily.png",
              "backgroundColor": "#ffffff"
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#6366f1"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 88,
          "resizeMode": "contain",
          "backgroundColor": "#f4f4f5",
          "dark": {
            "image": "./assets/splash-mark.png",
            "backgroundColor": "#121212"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59e373ea-5545-4ea5-a3da-9f9c6ec7ba2b"
      }
    },
    "owner": "jbuitrago1298"
  }
}
